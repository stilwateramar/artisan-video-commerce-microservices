# Local development uses Application Default Credentials: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
REGION=asia-south1
RAW_BUCKET=your-project-id-artisan-raw
MEDIA_BUCKET=your-project-id-artisan-media
MEDIA_BASE_URL=http://localhost:8080/media
TRANSCODE_JOB=artisan-transcoder
JWT_SECRET=change-me
# 1 = run the transcoder as a local child process instead of the Cloud Run Job
LOCAL_WORKER=0
PORT=8080
